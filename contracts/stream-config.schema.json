{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-monitor.local/contracts/stream-config.schema.json",
  "title": "StreamConfigDTO",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stream_id", "master_url", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stream_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "master_url": {"type": "string", "format": "uri", "minLength": 1},
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "startup_mode": "bounded_history",
        "startup_lookback_segments": 4
      },
      "required": ["startup_mode", "startup_lookback_segments"],
      "properties": {
        "startup_mode": {
          "enum": ["bounded_history", "full_snapshot"]
        },
        "startup_lookback_segments": {
          "type": "integer",
          "minimum": 1
        },
        "soft_lag_target_durations": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.0
        },
        "recovery_lag_target_durations": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.5
        },
        "hard_lag_target_durations": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 6.0
        },
        "live_edge_retention_segments": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "transition_cycles": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        }
      }
    },
    "variant_selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["all", "representative", "explicit"], "default": "all"},
        "representative_count": {"type": "integer", "minimum": 1, "default": 3},
        "explicit_variant_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["black_screen", "audio_loss"],
      "properties": {
        "black_screen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}
          }
        },
        "audio_loss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "threshold_dbfs", "duration_seconds"],
          "properties": {
            "enabled": {"type": "boolean"},
            "threshold_dbfs": {"type": "number", "maximum": 0},
            "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
            "track_index": {"type": "integer", "minimum": 0, "default": 0}
          }
        },
        "video_freeze": {
          "type": "object",
          "default": {
            "enabled": false,
            "noise_db": -60.0,
            "detector_minimum_duration": 0.2,
            "warning_duration_seconds": 3.0,
            "alert_duration_seconds": 5.0
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "noise_db",
            "detector_minimum_duration",
            "warning_duration_seconds",
            "alert_duration_seconds"
          ],
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "noise_db": {
              "type": "number",
              "maximum": 0,
              "default": -60.0
            },
            "detector_minimum_duration": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.2
            },
            "warning_duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 3.0
            },
            "alert_duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 5.0
            }
          }
        }
      }
    }
  }
}

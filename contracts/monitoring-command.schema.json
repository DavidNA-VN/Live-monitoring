{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-monitor.local/contracts/monitoring-command.schema.json",
  "title": "MonitoringCommandDTO",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "command_type",
    "stream_id",
    "requested_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "command_id": {"type": "string", "minLength": 1},
    "command_type": {
      "enum": ["START", "PAUSE", "RESUME", "STOP", "UPDATE_CONFIG"]
    },
    "stream_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "requested_at": {"type": "string", "format": "date-time"},
    "config": {"$ref": "stream-config.schema.json"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command_type": {"enum": ["START", "UPDATE_CONFIG"]}
        }
      },
      "then": {"required": ["config"]}
    }
  ]
}

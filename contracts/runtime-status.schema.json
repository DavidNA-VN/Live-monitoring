{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-monitor.local/contracts/runtime-status.schema.json",
  "title": "RuntimeStatusDTO",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stream_id",
    "status",
    "health",
    "active_variant_count",
    "queue_depth",
    "checks"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stream_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {
      "enum": ["CREATED", "STARTING", "RUNNING", "PAUSED", "STOPPING", "STOPPED", "FAILED"]
    },
    "health": {"enum": ["UNKNOWN", "HEALTHY", "DEGRADED", "UNHEALTHY"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "last_poll_at": {"type": ["string", "null"], "format": "date-time"},
    "active_variant_count": {"type": "integer", "minimum": 0},
    "queue_depth": {"type": "integer", "minimum": 0},
    "queue_lag_seconds": {"type": ["number", "null"], "minimum": 0},
    "live_edge_lag_seconds": {"type": ["number", "null"], "minimum": 0},
    "error": {"type": ["string", "null"]},
    "telemetry_available": {"type": "boolean"},
    "health_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "checks": {
      "type": "object",
      "additionalProperties": {"enum": ["ENABLED", "DISABLED"]}
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "observed_at": {"type": "string", "format": "date-time"}
    ,
    "admission_mode": {
      "enum": ["coverage", "catch_up", "live_edge_protection"],
      "default": "coverage"
    },
    "startup_segments_outside_scope": {"type": "integer", "minimum": 0, "default": 0},
    "dropped_expired_work": {"type": "integer", "minimum": 0, "default": 0},
    "dropped_capacity_work": {"type": "integer", "minimum": 0, "default": 0},
    "dropped_live_edge_work": {"type": "integer", "minimum": 0, "default": 0},
    "coverage_gap_count": {"type": "integer", "minimum": 0, "default": 0},
    "coverage_gap_segment_count": {"type": "integer", "minimum": 0, "default": 0},
    "dropped_media_segment_count": {"type": "integer", "minimum": 0, "default": 0},
    "profile_analysis_total": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0},
      "default": {}
    },
    "active_media_processes": {"type": "integer", "minimum": 0, "default": 0},
    "max_media_processes": {"type": "integer", "minimum": 0, "default": 0}
  }
}
